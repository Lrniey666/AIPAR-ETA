# 實驗室伙食系統 AIPARC ETA — 環境變數範例
#
# 埠衝突（本機常見）：APP_PORT／POSTGRES_PORT／OCR_HOST_PORT 只影響主機對映。
# 容器內 postgres 仍聽 5432、ocr 仍聽 8868；web／bot 會被 compose.yaml 覆寫，不必改容器內埠。

# ── 應用／資料庫（Docker Compose 必要）──────────────────
TZ=Asia/Taipei
LOG_LEVEL=info
APP_HOST=0.0.0.0
APP_PORT=3000
BOT_HEALTH_PORT=3001

# 本機直接跑 npm run start:* 時用 127.0.0.1
# 容器內會被 compose.yaml 覆寫成 postgres:5432
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aiparc_eta
POSTGRES_USER=aiparc
POSTGRES_PASSWORD=

# 網站對外位址（校內 IP＋APP_PORT）。Embed 標誌與 /網站 按鈕用它；留空＝不放圖
# Discord 圖床從外網抓不到內網 IP，若看到破圖就留空。
PUBLIC_BASE_URL=

# ── Discord ─────────────────────────────────────────────

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 只註冊到單一伺服器（立即生效，開發用）；留空＝全域註冊（約一小時）
DISCORD_GUILD_ID=

# ── LLM 閘道（清單式金鑰，0／1／N 把都要能運作）──────────
# 以逗號分隔多把金鑰；留空＝跳過該供應商而非報錯（.cursorrules §10.3）
GEMINI_API_KEYS=
GROQ_API_KEYS=
MISTRAL_API_KEYS=
IAI_API_KEYS=

# 模型 ID（PLAN §22-19）。**這裡刻意不給預設值，也請不要抄別處的字串填。**
# 各家的模型 ID 會下架、改名，而且「價目表上有的不一定打得到」——
# 有金鑰但沒填模型 ID 的供應商會被跳過並記錄原因，不會拿一個猜的 ID 去打 404。
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-20b
MISTRAL_MODEL=ministral-3b-latest
IAI_MODEL=Furen-std

# 視覺模型（菜單辨識用）。留空＝退回上面的文字模型，且僅限支援視覺的供應商
GEMINI_VISION_MODEL=gemini-3.6-flash
GROQ_VISION_MODEL=qwen3.8-27b
MISTRAL_VISION_MODEL=ministral-3b-latest
IAI_VISION_MODEL=std

# true 才啟用標成計費的供應商。iAI 為校內免費層，不必開此旗標。
LLM_ALLOW_METERED=false
# 覆寫嘗試順序（逗號分隔 key：groq,gemini,mistral,iai,local）；留空＝用程式預設
LLM_TEXT_ORDER=
LLM_VISION_ORDER=
# 本機模型保底（Ollama 等）。不要在 bot／web 容器內跑本地 LLM。
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_VISION_MODEL=
LOCAL_LLM_API_KEYS=

# ── 菜單對帳 OCR（PP-OCRv6 small）──────────────────────
# docker compose 會把 bot 的 OCR_BASE_URL 覆寫成 http://ocr:8868，不必為容器填。
# 本機直接跑 `npm run start:bot` 才需要指到下面這個主機位址。
# OCR_HOST_PORT 只改主機對映；留空且不走 compose 時＝整段略過。
OCR_HOST_PORT=8868
OCR_BASE_URL=http://127.0.0.1:8868
OCR_PATH=/ocr
OCR_MODEL=PP-OCRv6-small
OCR_API_KEY=
OCR_TIMEOUT_MS=60000
OCR_MIN_SCORE=0.6
