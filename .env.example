# 實驗室伙食系統 AIPAR ETA — 環境變數範例

# ── 應用／資料庫（Docker Compose 必要）──────────────────
TZ=Asia/Taipei
APP_HOST=0.0.0.0
APP_PORT=3000
BOT_HEALTH_PORT=3001

# 本機直接跑 npm run start:* 時用 127.0.0.1
# 容器內會被 compose.yaml 覆寫成 postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aipar_eta
POSTGRES_USER=aipar
POSTGRES_PASSWORD=

# ── Discord ─────────────────────────────────────────────

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── LLM 閘道（清單式金鑰，0／1／N 把都要能運作）──────────
# 以逗號分隔多把金鑰；留空＝跳過該供應商而非報錯（.cursorrules §10.3）
GEMINI_API_KEYS=
GROQ_API_KEYS=
MISTRAL_API_KEYS=
IAI_API_KEYS=

# 模型 ID（PLAN §22-19）。**這裡刻意不給預設值，也請不要抄別處的字串填。**
# 各家的模型 ID 會下架、改名，而且「價目表上有的不一定打得到」——
# 有金鑰但沒填模型 ID 的供應商會被跳過並記錄原因，不會拿一個猜的 ID 去打 404。
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-20b
MISTRAL_MODEL=ministral-3b-latest
IAI_MODEL=Furen-std

# 視覺模型（菜單辨識用）。留空＝退回上面的文字模型，且僅限支援視覺的供應商
GEMINI_VISION_MODEL=
MISTRAL_VISION_MODEL=
IAI_VISION_MODEL=