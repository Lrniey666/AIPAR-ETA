# 實驗室伙食系統 AIPAR ETA — 環境變數範例
# 複製成 .env 後填入。.env 已在 .gitignore，不會進版控。

# ── 應用／資料庫（Docker Compose 必要）──────────────────
TZ=Asia/Taipei
APP_HOST=0.0.0.0
APP_PORT=3000
BOT_HEALTH_PORT=3001

# debug / info / warn / error
LOG_LEVEL=info

# 本機直接跑 npm run start:* 時用 127.0.0.1
# 容器內會被 compose.yaml 覆寫成 postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aipar_eta
POSTGRES_USER=aipar
POSTGRES_PASSWORD=

# ── Discord ─────────────────────────────────────────────
# Bot → Privileged Gateway Intents 要打開 MESSAGE CONTENT，
# 否則收到的訊息內容是空字串，自然語言點餐與貼菜單都會失效。
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# 只把斜線指令註冊到這一台伺服器（立即生效，開發用）。
# 留空＝註冊為全域指令，要等 Discord 散播。
DISCORD_GUILD_ID=

# ── LLM 閘道（清單式金鑰，0／1／N 把都要能運作）──────────
# 以逗號分隔多把金鑰；留空＝跳過該供應商而非報錯。
GEMINI_API_KEYS=
GROQ_API_KEYS=
MISTRAL_API_KEYS=
IAI_API_KEYS=

# 模型 ID。**這裡刻意不給預設值，也請不要抄別處的字串填。**
# 各家的模型 ID 會下架、改名，而且「價目表上有的不一定打得到」——
# 有金鑰但沒填模型 ID 的供應商會被跳過並記錄原因，不會拿一個猜的 ID 去打 404。
# 填好後跑 `npm run llm:check` 確認真的打得通。
#
# 參考（2026-09-18 實測可用，不是保證值，請自己再驗一次）：
#   GEMINI_MODEL=gemini-3.6-flash        文字 1.7s／視覺 2.6s，中文菜單辨識最穩
#   GROQ_MODEL=openai/gpt-oss-20b        文字 0.7s，最快；此模型不吃圖
#   MISTRAL_MODEL=ministral-3b-latest    文字 0.6s，但指令遵循較弱
GEMINI_MODEL=
GROQ_MODEL=
MISTRAL_MODEL=
IAI_MODEL=

# 視覺模型（菜單辨識用）。留空＝退回上面的文字模型，且僅限支援視覺的供應商。
GEMINI_VISION_MODEL=
GROQ_VISION_MODEL=
MISTRAL_VISION_MODEL=
IAI_VISION_MODEL=

# 供應商嘗試順序（逗號分隔）。留空＝用內建順序：
#   文字 groq,gemini,mistral,iai,local（依實測延遲）
#   視覺 gemini,groq,mistral,iai,local（依實測辨識品質）
LLM_TEXT_ORDER=
LLM_VISION_ORDER=

# iAI 是按 token 計費、不是免費層，預設被擋掉。
# PLAN 要求只用免費 API；真的要用再改成 true。
LLM_ALLOW_METERED=false

# 本機模型保底（Ollama 等 OpenAI 相容端點）。留空＝不啟用。
# 實驗室機器效能普通，預設不開；要開請在容器外另跑。
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_VISION_MODEL=
