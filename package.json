{
  "name": "aipar-eta",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "實驗室伙食系統 AIPAR ETA",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start:web": "node --env-file=.env src/web.ts",
    "start:bot": "node --env-file=.env src/bot.ts",
    "register": "node --env-file=.env src/scripts/register-commands.ts",
    "smoke": "node --env-file=.env src/scripts/smoke.ts",
    "llm:check": "node --env-file=.env src/scripts/llm-check.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "compose:up": "docker compose up --build -d",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f --tail=100",
    "route:check": "node --env-file=.env src/scripts/route-check.ts"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2"
  }
}
