{
  "name": "aipar-eta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "實驗室伙食系統 AIPAR ETA",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start:web": "node --env-file=.env src/web.ts",
    "start:bot": "node --env-file=.env src/bot.ts",
    "typecheck": "tsc --noEmit",
    "compose:up": "docker compose up --build -d",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f --tail=100"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2"
  }
}
